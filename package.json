{
  "name": "gh-prq",
  "version": "0.1.0",
  "description": "Turn-based pull request queue for the GitHub CLI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.3.1"
  }
}
